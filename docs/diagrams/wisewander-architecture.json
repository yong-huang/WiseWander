  "cards": [
    {
      "dot": "cyan",
      "title": "Process model",
      "items": [
        "Pages live in renderer-side <webview> tags; the main-process TabManager keeps metadata only",
        "All cross-process traffic uses IPC_CHANNELS constants; streaming goes through webContents.send"
      ]
    },
    {
      "dot": "emerald",
      "title": "AI routing",
      "items": [
        "Providers are probed in priority order; the first online one serves each request (30s status cache)",
        "Privacy mode forces local-only; Stop truly aborts the HTTP stream via AbortSignal"
      ]
    },
    {
      "dot": "rose",
      "title": "Persistence",
      "items": [
        "SQLite (WAL) holds 11 tables: bookmarks/history/reading/monitor/research",
        "electron-store keeps provider priority and appearance/privacy settings; will-download persists download records"
      ]
    }
  ]
