  "cards": [
    {
      "dot": "cyan",
      "title": "Main path",
      "items": [
        "Send → invoke → ModelRouter → local model, chunks pushed one by one",
        "extractPageContext runs before send, injected as a <system> prefix"
      ]
    },
    {
      "dot": "rose",
      "title": "Stop truly aborts",
      "items": [
        "AI_CHAT_STOP finds the controller by tabId and aborts it",
        "fetch-level abort: the HTTP request actually disconnects"
      ]
    },
    {
      "dot": "emerald",
      "title": "Routing & fallback",
      "items": [
        "Providers probed in priority order; first online wins",
        "Privacy mode skips cloud; SSE fallback when offline"
      ]
    }
