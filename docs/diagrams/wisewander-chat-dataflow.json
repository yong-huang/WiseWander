{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "WiseWander AI 对话数据流",
    "locale": "zh-CN",
    "output": "wisewander-chat-dataflow.html",
    "viewBox": [
      1085,
      662
    ],
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-stream",
        "label": "主对话流",
        "focus": [
          "chat-ui",
          "aistore",
          "preload",
          "ipc",
          "router",
          "ollama"
        ],
        "note": "从发送到本地模型流式回包的主路径。"
      },
      {
        "id": "stop-path",
        "label": "Stop 中止路径",
        "focus": [
          "stop",
          "ipc",
          "router"
        ],
        "note": "AbortSignal 从 Stop 按钮贯穿到 HTTP 请求。"
      },
      {
        "id": "failover",
        "label": "云端兜底",
        "focus": [
          "router",
          "cloud"
        ],
        "note": "本地不可用时的云 provider 兜底。"
      }
    ]
  },
  "stages": [
    {
      "label": "发起 (Renderer)"
    },
    {
      "label": "桥接"
    },
    {
      "label": "编排 (Main)"
    },
    {
      "label": "路由与回推"
    },
    {
      "label": "推理"
    }
  ],
  "nodes": [
    {
      "id": "chat-ui",
      "type": "frontend",
      "label": "聊天面板",
      "sublabel": "Chat / Assistant",
      "stage": 0,
      "row": 0
    },
    {
      "id": "aistore",
      "type": "frontend",
      "label": "ai-store",
      "sublabel": "Zustand 会话状态",
      "stage": 0,
      "row": 2
    },
    {
      "id": "preload",
      "type": "security",
      "label": "Preload 桥",
      "sublabel": "aiChatSend / aiChatStop",
      "stage": 1,
      "row": 2
    },
    {
      "id": "stop",
      "type": "security",
      "label": "AbortController",
      "sublabel": "按 tabId 注册",
      "stage": 2,
      "row": 0
    },
    {
      "id": "ipc",
      "type": "backend",
      "label": "ai.ipc.ts",
      "sublabel": "AI_CHAT_SEND handler",
      "stage": 2,
      "row": 2
    },
    {
      "id": "events",
      "type": "messagebus",
      "label": "ai:chat:stream",
      "sublabel": "webContents.send",
      "stage": 3,
      "row": 0
    },
    {
      "id": "router",
      "type": "backend",
      "label": "ModelRouter",
      "sublabel": "优先级探测 · 故障转移",
      "stage": 3,
      "row": 2
    },
    {
      "id": "ollama",
      "type": "external",
      "label": "Ollama",
      "sublabel": "/api/chat NDJSON",
      "stage": 4,
      "row": 1
    },
    {
      "id": "cloud",
      "type": "cloud",
      "label": "云端 LLM",
      "sublabel": "SSE · OpenAI / Anthropic",
      "stage": 4,
      "row": 3
    }
  ],
  "flows": [
    {
      "id": "ui-store",
      "from": "chat-ui",
      "to": "aistore",
      "label": "sendMessage",
      "classification": "页面上下文随 <system> 前缀注入",
      "labelAt": [
        100,
        230
      ]
    },
    {
      "id": "store-preload",
      "from": "aistore",
      "to": "preload",
      "label": "aiChatSend",
      "classification": "invoke",
      "variant": "emphasis"
    },
    {
      "id": "preload-ipc",
      "from": "preload",
      "to": "ipc",
      "label": "AI_CHAT_SEND",
      "classification": "IPC 通道"
    },
    {
      "id": "ipc-stop",
      "from": "ipc",
      "to": "stop",
      "label": "注册 / 中止",
      "classification": "AI_CHAT_STOP",
      "variant": "security",
      "labelAt": [
        530,
        266
      ]
    },
    {
      "id": "ipc-events",
      "from": "ipc",
      "to": "events",
      "label": "逐 chunk 回推",
      "classification": "流式事件"
    },
    {
      "id": "ipc-router",
      "from": "ipc",
      "to": "router",
      "label": "chat + AbortSignal",
      "classification": "逐请求路由",
      "variant": "emphasis",
      "route": "straight",
      "labelAt": [
        640,
        444
      ]
    },
    {
      "id": "router-ollama",
      "from": "router",
      "to": "ollama",
      "label": "首个在线 provider",
      "classification": "本地优先",
      "variant": "emphasis"
    },
    {
      "id": "router-cloud",
      "from": "router",
      "to": "cloud",
      "label": "离线兜底",
      "classification": "SSE",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "主路径",
      "items": [
        "发送 → invoke → ModelRouter → 本地模型，chunk 逐条回推",
        "发送前注入页面上下文（<system> 前缀）"
      ]
    },
    {
      "dot": "rose",
      "title": "Stop 真中止",
      "items": [
        "AI_CHAT_STOP 按 tabId 找到 controller 并 abort",
        "fetch 级中止：HTTP 请求真正断开"
      ]
    },
    {
      "dot": "emerald",
      "title": "路由与兜底",
      "items": [
        "providers 按 priority 探测，首个在线者执行",
        "隐私模式跳过云端；离线时 SSE 兜底"
      ]
    }
  ]
}